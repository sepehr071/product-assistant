# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI account with GPT-Live access
OPENAI_API_KEY=

# Must match agent_name in agent/src/agent.py
AGENT_NAME=product-kiosk

# Optional: override product folder (defaults to <repo>/data/products)
# CATALOG_DIR=

# Allow the unauthenticated token route outside dev (trusted network only)
ALLOW_KIOSK_TOKEN=
